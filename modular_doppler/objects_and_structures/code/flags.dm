// Flags of Dopplershift
// Replaces the SSC flag with the flag of Crusoe's Rest, where we live.

/obj/structure/sign/flag/ssc
	name = "flag of Crusoe's Rest"
	desc = "The flag for the system of Crusoe's Rest. The crescent moon in the center represents Hallow, and the five stars within it simultaneously represent the five other planets and the fabled treasure that is supposedly on Hallow. The shotgun and machete below symbolize the self sufficient nature of the inhabitants, their pirate history, and their dogged habit of defending themselves, sometimes to the extreme."
	icon = 'modular_doppler/objects_and_structures/icons/flags.dmi'
	icon_state = "flag_crusoe"


