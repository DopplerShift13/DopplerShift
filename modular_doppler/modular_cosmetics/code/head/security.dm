// new doppler hats

/obj/item/clothing/head/hats/sec_beret_doppler
	name = "\improper Port Safety uniform beret"
	desc = "A floppy bit of fabric, one of the greatest cultural exports humankind has ever brought to the rest of the galactic \
	community. This one has a rather outdated soft-insert to give the wearer some level of protection, but most of the street-level guards of Port Safety tend to wear this most often out of all the headwear commonly given to them- much to the Commissioner's chagrin."
	icon = 'modular_doppler/modular_cosmetics/icons/security_resprite/doppler_security_obj.dmi'
	icon_state = "sec_beret"
	worn_icon = 'modular_doppler/modular_cosmetics/icons/security_resprite/doppler_security.dmi'
	armor_type = /datum/armor/cosmetic_sec

/obj/item/clothing/head/hats/hos/beret_doppler
	name = "\improper chief guard's beret"
	desc = "A much more fashionable beret than the last one you examined, this is one of the even greater cultural exports humankind has ever brought \
	to the rest of the galactic community. This one has an advanced soft-insert to give it a level of protection that could even stop low-caliber firearms, \
	providing one's opponent is kind enough to use subsonic ammunition to stop from piercing the hull of wherever you are right now."
	icon = 'modular_doppler/modular_cosmetics/icons/security_resprite/doppler_security_obj.dmi'
	worn_icon = 'modular_doppler/modular_cosmetics/icons/security_resprite/doppler_security.dmi'
	icon_state = "hos_beret"

// overrides some tg hats and helmets

/obj/item/clothing/head/hats/warden/drill
	name = "\improper dispatch officer's peaked cap"
	desc = "A 'combat cap,' this piece of headwear features a detachable heavy cloth sunflap to maximize ventilation. This also saves the wearer \
	from the horrific insectoids found outside of the enviroshields on New Gibraltar, even protecting against a Port Safety member's most powerful \
	nemesis- the afternoon heat."
	icon = 'modular_doppler/modular_cosmetics/icons/security_resprite/doppler_security_obj.dmi'
	worn_icon = 'modular_doppler/modular_cosmetics/icons/security_resprite/doppler_security.dmi'
	icon_state = "cap_warden"

/obj/item/clothing/head/hats/warden/red
	name = "\improper dispatch officer's havelock"
	desc = "A tall red cap with a wide black brim, the distinctive peak serves as an aegis against the rain. The red color offering visibility as \
	well as the ability to pretend to be a deep space warlord, if only for one's own entertainment."
	icon = 'modular_doppler/modular_cosmetics/icons/security_resprite/doppler_security_obj.dmi'
	worn_icon = 'modular_doppler/modular_cosmetics/icons/security_resprite/doppler_security.dmi'
	icon_state = "sunhat_warden"

/obj/item/clothing/head/helmet/sec
	name = "\improper PS Type 98c helmet"
	desc = "An extraordinarily basic and ordinarily timeless design, these are often made out of whatever high-carbon steel \
	can be recycled from no-longer-needed aspects of the colonization of New Gibraltar. These bad boys offer neck and ear coverage, \
	protection for the brain and other organs, and the much-needed luxury of a genuine leather chinstrap."
	icon = 'modular_doppler/modular_cosmetics/icons/security_resprite/doppler_security_obj.dmi'
	icon_state = "sec_helmet"
	worn_icon = 'modular_doppler/modular_cosmetics/icons/security_resprite/doppler_security.dmi'

/obj/item/clothing/head/hats/hos/cap
	name = "\improper chief guard's peaked cap"
	desc = "An upgraded version of the last peaked cap you might have examined, this is a tall black cap with a matching black brim, except this \
	one's been emblazoned with a gold badge representing the logo of the Port Safety Commission. Speaking of, one can find the Commissioner's \
	signature on a little tag on the inside, a common ritual despite the signer's busy schedule."
	icon = 'modular_doppler/modular_cosmetics/icons/security_resprite/doppler_security_obj.dmi'
	worn_icon = 'modular_doppler/modular_cosmetics/icons/security_resprite/doppler_security.dmi'
	icon_state = "hos_cap"
