// overrides tg backpacks
/obj/item/storage/backpack/security
	name = "\improper PS-C1 assault pack"
	desc = "Bespoke storage pieces were a relatively recent addition to the Port Safety kit, with off-the-rack \
	options filling the role for years. A pilot program into their development was started after a routine financial \
	audit revealed widespread misuse of gear stipends for designer bags that were not adequate for purpose, or even \
	intended to be used on the job at all."
	icon = 'modular_doppler/modular_cosmetics/icons/security_resprite/doppler_security_obj.dmi'
	worn_icon = 'modular_doppler/modular_cosmetics/icons/security_resprite/doppler_security.dmi'
	icon_state = "sec_backpack"

// new doppler backpack
/obj/item/storage/backpack/security/alt
	name = "\improper PS-C2 field pack"
	desc = "Broadly similar to its cousin-pack, but this one has some extra accoutrements for lashing camp gear to, \
	in addition to superior waterproofing. The top closure is noted by some as being a little obnoxious to handle in gloves."
	icon_state = "sec_backpack_alt"

// more tg bag overrides

/obj/item/storage/backpack/duffelbag/sec
	name = "\improper PS-C5 personal duffel"
	desc = "A sizable and versatile gear bag, but the cavernous main pocket lacks any organizers or dividers, leaving \
	users at the mercy of a dizzying array of surface pockets that are never quite right for little objects."
	icon = 'modular_doppler/modular_cosmetics/icons/security_resprite/doppler_security_obj.dmi'
	worn_icon = 'modular_doppler/modular_cosmetics/icons/security_resprite/doppler_security.dmi'
	icon_state = "sec_dufflebag"

/obj/item/storage/backpack/satchel/sec
	name = "\improper PS-C7 satchel pack"
	desc = "A simple bag with a large main compartment and a cross body strap. Getting gear out is convenient, \
	but the bag doesn't distribute heavy loads so well."
	icon = 'modular_doppler/modular_cosmetics/icons/security_resprite/doppler_security_obj.dmi'
	worn_icon = 'modular_doppler/modular_cosmetics/icons/security_resprite/doppler_security.dmi'
	icon_state = "sec_satchel"

/obj/item/storage/backpack/messenger/sec
	name = "\improper PS-C9 messenger pack"
	desc = "Originally designed for motorized package couriers, but adopted broadly as a simple and practical bag."
	icon = 'modular_doppler/modular_cosmetics/icons/security_resprite/doppler_security_obj.dmi'
	worn_icon = 'modular_doppler/modular_cosmetics/icons/security_resprite/doppler_security.dmi'
	icon_state = "sec_messenger"
